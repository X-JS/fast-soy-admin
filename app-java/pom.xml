<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父 POM：
         统一依赖版本、编译插件（release=java.version、parameters=true）、
         spring-boot-maven-plugin（含 repackage 执行）等默认配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.fastsoy</groupId>
    <artifactId>backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging> <!-- 父工程核心：pom，不再是jar -->
    <name>app-java-parent</name>
    <description>app-java多模块父工程</description>

    <!-- 声明子模块，后续新增模块在这里追加 -->
    <modules>
        <module>app-api</module>
        <module>app-common</module>
        <module>app-admin</module>
    </modules>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- 统一版本管理（Spring Boot 相关依赖的版本由 starter-parent 提供） -->
    <dependencyManagement>
        <dependencies>
            <!-- 内部模块统一版本 -->
            <dependency>
                <groupId>com.fastsoy</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
